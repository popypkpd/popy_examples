METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: flip_flop_cl_stderr
    title: Flip Flop tutorial fitting KA and CL
    author: PoPy for PK/PD
    abstract: |
        One compartment model with a depot leading into a central compartment.
        Fitting KA and CL, with V set to the true value.
    keywords: ['flip flop', 'dep_one_cmp_cl', 'one compartment model']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(1.0, 40.0; 100)
        f[KA] = 0.6
        f[CL] = 8
        f[V] = 20
        f[ANOISE_STD] = 0.1
FIT_EFFECTS:
    POP: |
        f[KA] ~ unif(0.25, 1.0) 0.5
        f[CL] ~ unif(6, 12) 10
        f[V] = 20
        f[ANOISE_STD] = 0.1
MODEL_PARAMS: |
    m[KA] = f[KA]
    m[CL] = f[CL]
    m[V] = f[V]
    m[ANOISE_STD] = f[ANOISE_STD]
DERIVATIVES: |
    d[DEPOT]   = @bolus{amt:c[AMT]} - m[KA]*s[DEPOT]
    d[CENTRAL] =                      m[KA]*s[DEPOT] - m[CL]*s[CENTRAL]/m[V]
PREDICTIONS: |
    p[DV_CENTRAL] = s[CENTRAL]/m[V]
    var = m[ANOISE_STD]**2
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
ODE_SOLVER: {CPPLSODA: {rtol: 0.001, max_nsteps: 75000}}
FIT_METHODS: [ND: {max_n_main_iterations: 0}]
COVARIANCE: {SANDWICH: {var_covariance_flag: True, inv_hessian_flag: True}}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 0.1}
    FIT: {output_mode: run, sim_time_step: 0.1}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
