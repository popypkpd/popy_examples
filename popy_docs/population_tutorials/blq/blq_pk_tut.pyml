METHOD_OPTIONS: {py_module: tut, rand_seed: 12345}
DESCRIPTION:
    name: blq_pk
    title: Depot + One compartment PK with BLQ
    author: PoPy for PK/PD
    abstract: |
        Depot One Comp PK model, with BLQ (below level of quantification) observations.
    keywords: ['tutorial', 'pk', 'advan4', 'dep_two_cmp', 'blq']
PARALLEL:
    MPI_WORKERS:
        n_workers: 4
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[AMT] = 100.0
        f[KA] = 0.2
        f[CL] = 2.0
        f[V1] = 50
        # f[Q] = 1.0
        # f[V2] = 80
        f[KA_isv,CL_isv,V1_isv] = [
            [0.1],
            [0.02, 0.03],
            [0.01, 0.02, 0.09],
        ]
        f[PNOISE] = 0.15
        f[ANOISE] = 0.01
    ID: |
        c[ID] = sequential(50)
        t[DOSE] = 2.0
        # t[OBS] ~ unif(1.0, 50.0; 5)
        # t[OBS] ~ unif(1.0, 50.0; 20)
        # t[OBS] = range(1.0, 50.0; 20)
        # t[OBS] = range(1.0, 50.0; 30)
        t[OBS] = range(1.0, 100.0; 20)
        r[KA, CL, V1] ~ mnorm([0,0,0], f[KA_isv,CL_isv,V1_isv])
FIT_EFFECTS:
    POP: |
        f[KA] ~ P1.0
        f[CL] ~ P1.0
        f[V1] ~ P20
        # f[Q] ~ P1.5
        # f[V2] ~ P100
        # f[V2] = 80
        f[KA_isv,CL_isv,V1_isv] ~ spd_matrix() [
            [0.05],
            [0.01, 0.05],
            [0.01, 0.01, 0.05],
        ]
        f[PNOISE] ~ P0.1
        f[ANOISE] = 0.01
        # f[ANOISE] ~ P0.01
    ID: |
        r[KA, CL, V1] ~ mnorm([0,0,0], f[KA_isv,CL_isv,V1_isv])
MODEL_PARAMS: |
    m[KA] = f[KA] * exp(r[KA])
    m[CL] = f[CL] * exp(r[CL])
    m[V1] = f[V1] * exp(r[V1])
    # m[Q] = f[Q] * exp(r[Q])
    # m[V2] = f[V2] * exp(r[V2])
    # m[ANOISE] = 0.001
    m[ANOISE] = f[ANOISE]
    m[PNOISE] = f[PNOISE]
DERIVATIVES: |
    # s[DEPOT,CENTRAL,PERI] = @dep_two_cmp_cl{dose:@bolus{amt:c[AMT]}}
    d[DEPOT] = @bolus{amt:c[AMT]} - m[KA]*s[DEPOT]
    d[CENTRAL] = m[KA]*s[DEPOT] - s[CENTRAL]*m[CL]/m[V1]
PREDICTIONS: |
    p[DV_CENTRAL] = s[CENTRAL]/m[V1]
    var = m[ANOISE]**2 + m[PNOISE]**2 * p[DV_CENTRAL]**2
    # c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
    c[DV_CENTRAL] ~ rectnorm(p[DV_CENTRAL], var, LLQ=0.5)
ODE_SOLVER: {CPPLSODA: {atol: 1e-06, rtol: 1e-06}}
FIT_METHODS: 
    - ND: {max_n_main_iterations: 30}
    # - JOE: {max_n_main_iterations: 30}
    # - FOCE: {max_n_main_iterations: 30}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0}
    FIT: {output_mode: run, sim_time_step: 1.0}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
