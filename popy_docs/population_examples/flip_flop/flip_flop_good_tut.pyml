METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: flip_flop_good_pop
    title: Flip Flop tutorial with low initial estimates of KA, V and CL
    author: PoPy for PK/PD
    abstract: |
        One compartment model with a depot leading into a central compartment.
        Note another interpretation of this is that the model is just over parametrised. Because here
        the KE and V parameters act independently unlike the CL/V and V parametrisation.
        Here initial values of KE, KA, V are close to the flipped values, so we get a good fit near the true global minima.
    keywords: ['one compartment model', 'flip flop', 'dep_one_cmp_k', 'good start values']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[AMT] = 500.0
        f[KE] = 0.05
        f[V] = 40
        f[KA] = 0.6
        f[PNOISE] = 0.01
        f[ANOISE] = 0.05
        f[KE_isv, V_isv,  KA_isv] = [[0.05, 0.0, 0.0],
                                     [0.0, 0.05, 0.0],
                                     [0.0, 0.0, 0.05]]
    ID: |
        c[ID] = sequential(30)
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(1.0, 50.0; 5)
        # t[OBS] = range(1.0, 50.0; 20)
        # t[OBS] = range(1.0, 50.0; 5)
        r[KE, V, KA] ~ mnorm( [0,0,0], f[KE_isv, V_isv, KA_isv] )
FIT_EFFECTS:
    POP: |
        f[KE] ~ unif(0.001, 10) 0.02
        f[V] ~ unif(0.1, 200) 30
        f[KA] ~unif (0.001, 1) 0.3
        f[PNOISE] ~ unif(0.001, 1) 0.05
        f[ANOISE] ~ unif(0.001, 1) 0.1
        f[KE_isv, V_isv, KA_isv] ~ spd_matrix() [[0.02],
                                                 [0.0, 0.02],
                                                 [0.0, 0.0, 0.02]]
    ID: |
        r[KE, V, KA] ~ mnorm( [0,0,0], f[KE_isv, V_isv, KA_isv] )
MODEL_PARAMS: |
    m[KE] = f[KE] * exp(r[KE])
    m[V] = f[V] * exp (r[V])
    m[KA] = f[KA] * exp (r[KA])
    m[PNOISE] = f[PNOISE]
    m[ANOISE] = f[ANOISE]
DERIVATIVES: |
    d[DEPOT] = @bolus{amt:c[AMT]} - m[KA]*s[DEPOT]
    d[CENTRAL] = m[KA]*s[DEPOT] - m[KE]*s[CENTRAL]
PREDICTIONS: |
    p[DV_CENTRAL] = s[CENTRAL]/m[V]
    var = (p[DV_CENTRAL] * m[PNOISE])**2 + m[ANOISE]**2
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
ODE_SOLVER: {CPPLSODA: {rtol: 0.001, max_nsteps: 75000}}
FIT_METHODS: 
    - ND: {max_n_main_iterations: 30}
    # - JOE: {max_n_main_iterations: 30}
    # - FOCE: {max_n_main_iterations: 30}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0}
    FIT: {output_mode: run, sim_time_step: 1.0}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
