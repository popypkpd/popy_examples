METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: weight_covariate
    title: Body Weight Covariate
    author: PoPy for PK/PD
    abstract: |
        One compartment model with absorption compartment and CL/V parametrisation.
        There are no random effects here. Each individual just has a different weight.
        The weight is a covariate for the m[CL] clearance parameter for each individual.
        Only the f[WT_EFFECT] and f[V] fixed effect parameters are estimated, other f[X] are fixed.
    keywords: ['one compartment model', 'dep_one_cmp_cl', 'weight', 'covariate effect']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        f[KA] = 0.3
        f[CL] = 3
        f[V] = 20
        f[PNOISE] = 0.1
        f[ANOISE] = 0.05
        f[WT_EFFECT] = 0.75  # new fixed effect
    ID: |
        c[ID] = sequential(30)
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(1.0, 50.0; 4)
        c[WT] ~ norm(70, 100)  # new covariate
FIT_EFFECTS:
    POP: |
        f[KA] = 0.3
        f[CL] = 3
        f[V] ~ unif (0.01, 100) 15  # existing fixed effect to be estimated
        f[PNOISE] = 0.1
        f[ANOISE] = 0.05
        f[WT_EFFECT] ~ U 1.0  # new fixed effect to be estimated
    ID: |
MODEL_PARAMS: |
    m[KA] = f[KA]
    m[CL] = f[CL]*(c[WT]/70)**f[WT_EFFECT]  # new covariate effect
    m[V] = f[V]*(c[WT]/70)  # new covariate effect
    m[PNOISE] = f[PNOISE]
    m[ANOISE] = f[ANOISE]
DERIVATIVES: |
    d[DEPOT] = 0
    d[CENTRAL] = 0
    d[DEPOT] += @bolus{amt:c[AMT]}
    d[DEPOT->CENTRAL] += m[KA]*s[DEPOT]
    d[CENTRAL] -= m[CL]*s[CENTRAL]/m[V]
PREDICTIONS: |
    plabel[DV_CENTRAL] = "Drug Concentration (mg/L)"
    clabel[TIME] = "Time (minutes)"
    p[DV_CENTRAL] = s[CENTRAL]/m[V]
    var = (p[DV_CENTRAL] * m[PNOISE])**2 + m[ANOISE]**2
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
ODE_SOLVER: {CPPLSODA: {rtol: 1e-06, max_nsteps: 750}}
FIT_METHODS: 
    - ND: {max_n_main_iterations: 30}
    # - JOE: {max_n_main_iterations: 30}
    # - FOCE: {max_n_main_iterations: 30}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    FIT: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
