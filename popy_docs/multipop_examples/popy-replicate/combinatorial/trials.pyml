METHOD_OPTIONS: {py_module: gen, rand_seed: 12345}

EFFECTS:
    POP: |
    ID: |
        c[ID] = sequential(3)
    POPSIZE: |
        c[POPSIZE] = sequential([10,20,40])
    NDOSES: |
        c[NDOSES] = sequential([1,3])
    PNOISE_MULT: |
        c[PNOISE_MULT] = sequential([1,2,3])
        
        # Putting RANDSEED at the leaf level ensures that 
        # every population is sampled differently (if so desired).
        c[RANDSEED] ~ unifint(1,1000000)
        t[OBS] = [0]  # at least one time point must be defined
        
        
POSTPROCESS: |
    c[ID] = (  
        f"n{int(c[POPSIZE])}-"
        f"d{int(c[NDOSES])}-"
        f"p{int(c[PNOISE_MULT])}-"
        f"pop{int(c[ID])-1:04}"
    )  # reformat the ID field
    
    if c[NDOSES] == 1:
        # Entries must be either a float or a string
        # A string substituted verbatim will be interpreted 
        # as desired downstream.
        c[DOSE_TIMES] = "[2]"
    elif c[NDOSES] == 3:
        c[DOSE_TIMES] = "[4,8,12]"
        
    c[PNOISE_VAR] = 0.05*c[PNOISE_MULT]
    
    del c[orig_data_row]
