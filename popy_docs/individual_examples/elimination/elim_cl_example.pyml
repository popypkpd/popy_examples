METHOD_OPTIONS: {py_module: tut, rand_seed: 123456}
DESCRIPTION:
    name: elim_cl_example
    title: Elimination Example with Clearance
    author: PoPy for PK/PD
    abstract: |
        Closed form solution for a one compartment model with IV dosing.
    keywords: ['closed form solution', 'clearance', 'one compartment model', 'advan1']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[CL] = 2
        c[V] = 20

        c[AMT] = 100.0
        t[DOSE] = 1.0
        t[OBS] = range(1, 40; 20)
FIT_EFFECTS:
    POP: |
MODEL_PARAMS: |
DERIVATIVES: |
    d[CENTRAL_AMT] = @bolus{amt: c[AMT]} - c[CL]/c[V]*s[CENTRAL_AMT]
PREDICTIONS: |
    p[CENTRAL_CONC] = s[CENTRAL_AMT]/c[V]
    plabel[CENTRAL_CONC] = "Drug Concentration (mg/L)"
    clabel[TIME] = "Time (minutes)"
    c[CENTRAL_CONC] ~ norm(p[CENTRAL_CONC], 0.0)
ODE_SOLVER:
    CPPLSODA: {}
FIT_METHODS: [ND: {}]
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0}
    FIT: {output_mode: none, sim_time_step: 1.0}
    COMP: {output_mode: none}
    TUTSUM: {output_mode: none}
