METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: biolag_both_stderr
    title: Bioavailability and Lag
    author: PoPy for PK/PD
    abstract: |
        One compartment model. Bolus dosing with bioavailability and lag parameters to estimate.
    keywords: ['one compartment model', 'iv_one_cmp_k', 'identifiability', 'bioavailability', 'lag']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(5.0, 40.0; 100)
        f[LAG] = 3.0
        f[BIO] = 0.6376
        f[KE] = 0.15
        f[ANOISE_STD] = 1.0
FIT_EFFECTS:
    POP: |
        f[LAG] ~ unif(0, 6) 5.0
        f[BIO] ~ unif(0, 1) 0.2
        f[KE] = 0.15
        f[ANOISE_STD] = 1.0
MODEL_PARAMS: |
    m[LAG] = f[LAG]
    m[BIO] = f[BIO]
    m[KE] = f[KE]
    m[ANOISE_STD] = f[ANOISE_STD]
DERIVATIVES: |
    d[CENTRAL] = @bolus{amt:c[AMT]*m[BIO], lag: m[LAG]}  # dose in
    d[CENTRAL] -= m[KE]*s[CENTRAL]  # elimination out
PREDICTIONS: |
    p[DV_CENTRAL] = s[CENTRAL]
    var = m[ANOISE_STD]**2
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
ODE_SOLVER: {CPPLSODA: {rtol: 0.001, max_nsteps: 75000}}
FIT_METHODS: [ND: {max_n_main_iterations: 0}]
COVARIANCE: {SANDWICH: {var_covariance_flag: True, inv_hessian_flag: True}}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 0.1}
    FIT: {output_mode: run, sim_time_step: 0.1}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
