METHOD_OPTIONS: {py_module: tut, rand_seed: 123456}
DESCRIPTION:
    name: gamma_dosing_repeated
    title: Repeated Gamma Dose with first order elimination.
    author: PoPy for PK/PD
    abstract: |
        Repeated gamma dose into single compartment with first order elimination.
    keywords: ['gamma', 'repeated', 'one compartment model']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 95.0
        t[RESET] = 0.0
        t[DOSE] = range(1, 76; 4)
        t[OBS] = range(1, 100; 20)
        c[CL] = 3
        c[V] = 20
FIT_EFFECTS:
    POP: |
MODEL_PARAMS: |
DERIVATIVES: |
    d[CENTRAL] = @gamma{amt:c[AMT], alpha: 15.0, beta: 1.0} - c[CL]*s[CENTRAL]/c[V]
PREDICTIONS: |
    plabel[DRUG] = "Drug Concentration (mg/L)"
    clabel[TIME] = "Time (minutes)"
    p[DRUG] = s[CENTRAL]/c[V]
    c[DRUG] ~ norm(p[DRUG], 0.0)
ODE_SOLVER: {CPPLSODA: {rtol: 1e-06, max_nsteps: 750}}
FIT_METHODS: [ND: {}]
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    FIT: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
