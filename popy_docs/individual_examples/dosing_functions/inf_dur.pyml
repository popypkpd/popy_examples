METHOD_OPTIONS: {py_module: tut, rand_seed: 123456}
DESCRIPTION:
    name: inf_dur_dosing
    title: Infusion Duration Dose with no elimination.
    author: PoPy for PK/PD
    abstract: |
        Infusion into single compartment, parametrised by duration. No elimination.
    keywords: ['inf_dur', 'one compartment model']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 95.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] = range(1, 40; 20)
        c[CL] = 3
        c[V] = 20
FIT_EFFECTS:
    POP: |
MODEL_PARAMS: |
DERIVATIVES: |
    d[CENTRAL] = @inf_dur{amt:c[AMT], dur: 19.0}
PREDICTIONS: |
    plabel[DRUG] = 'Cumulative dose administered (mg)'
    clabel[TIME] = "Time (minutes)"
    p[DRUG] = s[CENTRAL]
    c[DRUG] ~ norm(p[DRUG], 0.0)
ODE_SOLVER: {CPPLSODA: {rtol: 1e-06, max_nsteps: 750}}
FIT_METHODS: [ND: {}]
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    FIT: {output_mode: run, sim_time_step: 0.1, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
