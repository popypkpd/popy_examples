METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: flip_flop_bad
    title: Flip Flop tutorial with inaccurate starting values
    author: PoPy for PK/PD
    abstract: |
        One compartment model with a depot leading into a central compartment.
        Here initial values of KE, KA, V are close to the flipped values, so we get a bad fit in the false minima.
    keywords: ['flip flop', 'dep_one_cmp_k', 'one compartment model', 'poor start values']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(1.0, 40.0; 100)
        f[KA] = 0.15
        f[KE] = 0.3
        f[ANOISE_STD] = 1.0
FIT_EFFECTS:
    POP: |
        f[KA] ~ unif(0.001, 1) 0.1
        f[KE] ~ unif(0.001, 10) 1.0
        f[ANOISE_STD] ~ unif(0.001, 10) 5.0
MODEL_PARAMS: |
    m[KE] = f[KE]
    m[KA] = f[KA]
    m[ANOISE_STD] = f[ANOISE_STD]
DERIVATIVES: |
    d[DEPOT]   = @bolus{amt:c[AMT]} - m[KA]*s[DEPOT]
    d[CENTRAL] =                      m[KA]*s[DEPOT] - m[KE]*s[CENTRAL]
PREDICTIONS: |
    p[DV_CENTRAL] = s[CENTRAL]
    var = m[ANOISE_STD]**2
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], var)
ODE_SOLVER: {CPPLSODA: {rtol: 0.001, max_nsteps: 75000}}
FIT_METHODS: 
    - ND: {max_n_main_iterations: 30}
    # - JOE: {max_n_main_iterations: 30}
    # - FOCE: {max_n_main_iterations: 30}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0}
    FIT: {output_mode: run, sim_time_step: 1.0}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
