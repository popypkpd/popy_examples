METHOD_OPTIONS: {py_module: tut, rand_seed: 123456}
DESCRIPTION:
    name: iv_one_cmp_cl_anyl
    title: One Compartment Model with Intravenous Dosing (Closed Form)
    author: PoPy for PK/PD
    abstract: |
        One Compartment Model with Intravenous Dosing
        Elimination rate parametrised by clearance (CL)
        and volume of distribution (V).
        Model uses a closed form solution.
    keywords: ['iv_one_cmp_cl', 'one compartment model', 'advan1', 'trans2']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] = range(1, 40; 20)
        c[CL] = 3
        c[V] = 20
FIT_EFFECTS:
    POP: |
MODEL_PARAMS: |
DERIVATIVES: |
    s[CENTRAL] = @iv_one_cmp_cl{
        dose: @bolus{amt:c[AMT]},
        CL: c[CL], V: c[V] }
PREDICTIONS: |
    plabel[DV_CENTRAL] = "Drug Concentration (mg/L)"
    clabel[TIME] = "Time (minutes)"
    p[DV_CENTRAL] = s[CENTRAL]/c[V]
    c[DV_CENTRAL] ~ norm(p[DV_CENTRAL], 0.0)
ODE_SOLVER: {ANALYTIC: {}}
FIT_METHODS: [ND:{}]
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0, grph_list: ["OBS_vs_TIME", "{OBS}_vs_TIME"]}
    TUTSUM: {output_mode: run}
