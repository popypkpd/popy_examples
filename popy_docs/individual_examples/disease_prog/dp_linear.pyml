METHOD_OPTIONS: {py_module: tut, rand_seed: 314159}
DESCRIPTION:
    name: dp_linear
    title: linear_disease_progression_model
    author: Andrew Cristinacce @ PoPy for PK/PD
    abstract: |
        Specifies both the pop_gen and pop_fit subscripts.
        A disease progression model, based on the concentration of drug in the central compartment.
        The amount in the central compartment is determined by CL/V, which has been previously estimated for each individual.
        The disease increases linearly over time, but is initially reduced by the drug concentration.
    keywords: ['PD', 'Pharmacodynamics', 'one compartment model', 'linear disease progression']
FILE_PATHS: {output_file_ext: ['svg', 'pdf']}
GEN_EFFECTS:
    POP: |
        c[ID] = 1
        c[AMT] = 100.0
        t[RESET] = 0.0
        t[DOSE] = 1.0
        t[OBS] ~ unif(1.0, 40.0; 100)
        c[CL] ~ unif(1,5)
        c[V] ~ unif(10,30)
        f[ALPHA] = 0.3
        f[BETA] = 0.8
FIT_EFFECTS:
    POP: |
        f[ALPHA] ~ unif (0.001, 10) 0.2
        f[BETA] ~ unif (0.001, 10) 0.5
MODEL_PARAMS: |
    m[ALPHA] = f[ALPHA]
    m[BETA] = f[BETA]
STATES: |
DERIVATIVES: |
    d[CENTRAL] = @bolus{amt:c[AMT], lag:0} - c[CL]*s[CENTRAL]/c[V]
PREDICTIONS: |
    plabel[DIS] = 'Disease'
    p[DIS] = m[ALPHA]*c[TIME] - m[BETA]*s[CENTRAL]/c[V]
    c[DIS] ~ norm(p[DIS], 1.0)
ODE_SOLVER: {CPPLSODA: {rtol: 1e-06, max_nsteps: 75000}}
FIT_METHODS: 
    - ND: {max_n_main_iterations: 30}
    # - JOE: {max_n_main_iterations: 30}
    # - FOCE: {max_n_main_iterations: 30}
OUTPUT_SCRIPTS:
    GEN: {output_mode: run, sim_time_step: 1.0}
    FIT: {output_mode: run, sim_time_step: 1.0}
    COMP: {output_mode: run}
    TUTSUM: {output_mode: run}
